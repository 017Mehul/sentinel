# ==========================================
# Server
# ==========================================
APP_ENV=development
APP_PORT=8080
GRPC_PORT=9090
APP_NAME=auth-service
APP_VERSION=1.0.0

# ==========================================
# Database (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authdb
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# ==========================================
# Redis
# ==========================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ==========================================
# JWT (RS256)
# ==========================================
# PEM-encoded private key (use \n for newlines when setting in env)
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h   # 30 days
JWT_ISSUER=auth-service
JWT_AUDIENCE=api

# ==========================================
# Secrets Provider
# ==========================================
# Options: local, vault, aws
SECRET_PROVIDER=local

# HashiCorp Vault (if SECRET_PROVIDER=vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_MOUNT_PATH=secret

# AWS (if SECRET_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_SECRET_PREFIX=auth-service/

# ==========================================
# NATS JetStream
# ==========================================
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=AUTH
NATS_STREAM_SUBJECTS=auth.>
NATS_CONSUMER_NAME=auth-consumer

# ==========================================
# Email / SMTP
# ==========================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Auth Service
SMTP_FROM_EMAIL=noreply@example.com
SMTP_TLS_ENABLED=false

# ==========================================
# OAuth2
# ==========================================
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/oauth/google/callback

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/oauth/github/callback

OAUTH_STATE_SECRET=changeme-oauth-state-hmac-secret

# ==========================================
# AES Encryption (OAuth tokens at rest)
# ==========================================
# Must be exactly 32 bytes (256-bit)
AES_ENCRYPTION_KEY=changeme-32-byte-aes-key-here!!!

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_RPM=5       # requests per minute for auth endpoints
RATE_LIMIT_GENERAL_RPM=100  # requests per minute for general endpoints
RATE_LIMIT_WINDOW=60s

# ==========================================
# Security
# ==========================================
BCRYPT_COST=12
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=15m
PASSWORD_RESET_TOKEN_TTL=1h
EMAIL_VERIFICATION_TOKEN_TTL=24h
IDEMPOTENCY_KEY_TTL=24h
REPLAY_DETECT_WINDOW=120s
MFA_OTP_WINDOW=1              # number of 30s windows to tolerate (clock drift)
MFA_BACKUP_CODE_COUNT=10

# ==========================================
# CORS
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# ==========================================
# HIBP (Have I Been Pwned)
# ==========================================
HIBP_ENABLED=true
HIBP_API_TIMEOUT=3s

# ==========================================
# OpenTelemetry / Jaeger
# ==========================================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=auth-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLE_RATIO=1.0

# ==========================================
# Feature Flags
# ==========================================
FEATURE_FLAGS_FILE=./configs/feature_flags.yaml
FEATURE_FLAGS_RELOAD_INTERVAL=30s

# ==========================================
# Webhook
# ==========================================
WEBHOOK_DELIVERY_TIMEOUT=10s
WEBHOOK_MAX_RETRIES=5

# ==========================================
# TLS (production)
# ==========================================
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# ==========================================
# Graceful Shutdown
# ==========================================
SHUTDOWN_TIMEOUT=30s
